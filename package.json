    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "vite": "^5.4.1",
    "wait-on": "^8.0.1"
  }
