{
  "name": "r3f-ultimate-character-configurator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gateway": "node server/gateway.mjs",
    "mcp": "node mcp/server.mjs",
    "demo": "concurrently -k -n gateway,web \"node server/gateway.mjs\" \"vite\"",
    "electron": "electron .",
    "pet:dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "pet": "vite build && electron ."
  },
  "dependencies": {
    "@gltf-transform/core": "^4.0.10",
    "@gltf-transform/extensions": "^4.0.10",
    "@gltf-transform/functions": "^4.0.10",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@react-spring/three": "9.6.1",
    "@react-three/drei": "^9.112.0",
    "@react-three/eslint-plugin": "^0.1.1",
    "@react-three/fiber": "^8.17.7",
    "@react-three/postprocessing": "^2.16.3",
    "@types/three": "^0.168.0",
    "leva": "^0.9.35",
    "pocketbase": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.168.0",
    "three-stdlib": "^2.33.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0-rc.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
